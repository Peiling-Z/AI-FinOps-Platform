# LLM Provider: vertex (Gemini via Vertex AI) | multi (Gemini + Claude + GPT)
LLM_PROVIDER=vertex
MOCK_LLM=true

# Vertex AI (required when MOCK_LLM=false and LLM_PROVIDER=vertex)
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=us-central1

# Optional — only needed when LLM_PROVIDER=multi
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LangSmith (tracing & eval)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-finops-platform
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# BigQuery — LLM cost analytics sink (optional)
BIGQUERY_ENABLED=false
BIGQUERY_PROJECT=
BIGQUERY_DATASET=finops_analytics
BIGQUERY_TABLE=llm_usage
BIGQUERY_LOCATION=US
BIGQUERY_AUTO_CREATE=true

# Plaid (optional — sandbox)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# App
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
