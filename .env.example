# LLM Providers (set at least one for live inference)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=us-central1

# Plaid (optional — sandbox)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# LangSmith (optional — tracing & eval)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-finops-platform

# App
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
MOCK_LLM=true
